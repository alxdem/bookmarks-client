{
  "name": "My Extension",
  "version": "1.0",
  "manifest_version": 3,
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [],
  "icons": {
    "128": "128.png"
  },
  "action": {
    "default_icon": {
      "128": "128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.supabase.co"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://esm.sh; object-src 'self'"
  }
}